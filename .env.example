# Chaves dos provedores de LLM que usam API (ADR-017). Copie para .env e preencha só as que for usar:
#
#   cp .env.example .env
#
# O .env é ignorado pelo git. As chaves nunca são impressas nem gravadas: o pipeline só informa se
# existem (uv run python executar_infra.py). Variáveis já definidas no ambiente têm prioridade sobre o
# .env, e uma variável vazia conta como ausente.
#
# Os provedores por assinatura ou locais não precisam de chave aqui:
#   claude-cli  -> login na CLI claude
#   codex-cli   -> login na CLI codex (conta do ChatGPT)
#   gemini-agy  -> login na CLI agy
#   ollama      -> Ollama rodando em http://localhost:11434

# claude-api (Anthropic). Alternativa: um perfil do "ant auth login" em ~/.config/anthropic.
ANTHROPIC_API_KEY=
# Alternativa à chave: token de autenticação. Para usá-lo, descomente a linha abaixo e apague a
# ANTHROPIC_API_KEY acima.
# ANTHROPIC_AUTH_TOKEN=

# openai (API da OpenAI)
OPENAI_API_KEY=

# huggingface (Inference Providers). Alternativa: o token salvo pelo "hf auth login".
HF_TOKEN=
# Nome antigo do mesmo token, aceito no lugar de HF_TOKEN.
# HUGGING_FACE_HUB_TOKEN=
