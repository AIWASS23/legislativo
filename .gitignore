# Ambiente virtual (recriado com: uv venv && uv pip install -r requirements-dev.txt)
.venv/

# Caches do Python e das ferramentas
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.env

# Arquivo temporário da gravação atômica da planilha de rótulos (só sobra se a gravação for interrompida)
*.csv.tmp

# Logs das execuções em segundo plano (o resultado fica no cache runs/ e nos relatórios)
*.log
